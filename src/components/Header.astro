---
// Normalize trailing slash — some hosts add one even with trailingSlash: 'never'
const path = Astro.url.pathname.replace(/\/$/, "") || "/";
---

<header>
  <nav aria-label="Primary">
    <ul>
      <li class:list={[{ active: path === "/" }]}>
        <a href="/" aria-current={path === "/" ? "page" : undefined}>Home</a>
      </li>
      <li class:list={[{ active: path === "/contact" }]}>
        <a href="/contact" aria-current={path === "/contact" ? "page" : undefined}>Contact</a>
      </li>
    </ul>
  </nav>
</header>

<style>
  header {
    height: 5vh;
  }
  nav {
    background-color: rgba(255, 255, 255, 0.5);
    padding: 0.15rem;
  }
  ul {
    display: flex;
    flex-direction: row;
    flex-wrap: nowrap;
    justify-content: left;
    align-items: baseline;
  }
  li {
    list-style-type: none;
    margin: 0;
  }
  li a {
    margin: 1rem;
    color: black;
  }
  li.active {
    font-weight: bold;
  }
</style>
