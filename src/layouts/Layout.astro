---
import Header from "../components/Header.astro";
import {
  BACKGROUND_DESKTOP,
  BACKGROUND_MOBILE,
  BACKGROUND_MOBILE_MAX,
  BACKGROUND_ORIGIN,
} from "../lib/background.js";
import { routePath } from "../lib/route-path.js";
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
}

const { title, description = title } = Astro.props;

const canonical = new URL(routePath(Astro.url.pathname), Astro.site).href;
// Purpose-built 1200x630 social card (the de-facto Open Graph size): the
// buckley.ca logo and wordmark. Served from /public so og:image:width/height
// are accurate and there's no external dependency. See scripts/og-card.html.
const ogImage = new URL("/og.png", Astro.site ?? canonical).href;
const ogImageAlt = "buckley.ca";

// Defined once on :root rather than with `define:vars`, which repeats the
// declaration on every element the scoped style touches (<html>, <body> and
// <main> here) — three copies of two long URLs in the critical HTML.
const backgroundVars =
  `:root{--background-desktop:url(${BACKGROUND_DESKTOP});` +
  `--background-mobile:url(${BACKGROUND_MOBILE})}`;

const siteUrl = Astro.site?.href ?? canonical;
const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": `${siteUrl}#website`,
      url: siteUrl,
      name: "buckley.ca",
      publisher: { "@id": `${siteUrl}#person` },
    },
    {
      "@type": "Person",
      "@id": `${siteUrl}#person`,
      name: "Sean Buckley",
      url: siteUrl,
    },
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <link rel="icon" type="image/png" href="/favicon.png" />

    <!--
      The Cloudinary background is the LCP element, and it is referenced only
      from CSS — so the browser can't discover it until the stylesheet has
      loaded and layout has run. Open the connection early and preload the one
      crop this viewport will actually paint (see src/lib/background.js).
    -->
    <link rel="preconnect" href={BACKGROUND_ORIGIN} />
    <link
      rel="preload"
      as="image"
      fetchpriority="high"
      media={`(max-width: ${BACKGROUND_MOBILE_MAX}px)`}
      href={BACKGROUND_MOBILE}
    />
    <link
      rel="preload"
      as="image"
      fetchpriority="high"
      media={`(min-width: ${BACKGROUND_MOBILE_MAX + 1}px)`}
      href={BACKGROUND_DESKTOP}
    />
    <style is:inline set:html={backgroundVars}></style>
    <meta name="author" content="Sean Buckley" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <!-- Open Graph / social previews -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="buckley.ca" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    <!-- Structured data for search engines / AI agents -->
    <script type="application/ld+json" is:inline set:html={JSON.stringify(structuredData)}></script>
  </head>
  <body>
    <main class="background">
      <Header />
      <slot />
    </main>
  </body>
</html>

<style>
  .background {
    background: var(--background-desktop) fixed no-repeat center center;
    background-size: cover;
  }

  /* Keep in step with BACKGROUND_MOBILE_MAX in src/lib/background.js. */
  @media (max-width: 640px) {
    .background {
      background-image: var(--background-mobile);
    }
  }
</style>
