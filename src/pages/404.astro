---
import Layout from "../layouts/Layout.astro";
import Compass from "../components/Compass.astro";
---

<Layout title="Buckley.ca - Not Found" description="The page you're looking for couldn't be found.">
  <section class="center">
    <div class="box">
      <div class="compass-wrap">
        <Compass />
      </div>

      <h1>404 | Page not found</h1>
      <p>
        Looks like you've wandered off the map. The page you're after may have moved, or it never
        existed in the first place.
      </p>

      <nav class="links" aria-label="Get back on track">
        <a href="/" class="btn btn--primary">Back home</a>
        <a href="/contact" class="btn">Contact</a>
      </nav>
    </div>
  </section>
</Layout>

<style>
  .center {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    height: 95vh;
  }

  .box {
    max-width: 32rem;
    text-align: center;
    background-color: rgba(255, 255, 255, 0.75);
    padding: 2rem 1.5rem;
    border-radius: 10px;
  }

  .compass-wrap {
    margin-bottom: 0.5rem;
  }

  h1 {
    font-size: 2.25rem;
    font-weight: 600;
    margin: 0 0 0.5rem;
    text-shadow: 0.4px 0.8px 0.8px hsl(0deg 0% 0% / 0.15);
  }

  p {
    margin: 0 auto 1.5rem;
    max-width: 28rem;
    line-height: 1.5;
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    justify-content: center;
  }

  .btn,
  .btn:visited {
    display: inline-block;
    padding: 0.5rem 1.25rem;
    border-radius: 6px;
    border: 1px solid #ccc;
    background-color: #f4f4f4;
    color: #333;
  }

  .btn:hover {
    text-decoration: none;
    border-color: #666;
    background-color: #e9e9e9;
  }

  .btn--primary,
  .btn--primary:visited {
    border-color: #333;
    background-color: #333;
    color: #f4f4f4;
  }

  .btn--primary:hover {
    border-color: #000;
    background-color: #222;
  }

  @media (min-width: 640px) {
    section {
      max-width: none;
    }
  }
</style>
